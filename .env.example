# Base URL of the backend API. The frontend only talks to the backend through this URL.
# Local:      http://localhost:5000/api          (put this in .env.local)
# Production: https://vertex-management-backend.vercel.app/api  (see .env.production / Vercel env)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Currency symbol shown in the UI
NEXT_PUBLIC_CURRENCY=Rs
